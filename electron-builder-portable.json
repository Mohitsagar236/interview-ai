{
  "appId": "space.interviewai.app",
  "productName": "Interview AI Assistant",
  "files": [
    "electron/**/*",
    "renderer/**/*",
    "public/**/*",
    "assets/**/*",
    "package.json",
    "!python/__pycache__/**/*",
    "!**/*.pyc",
    "!python-dist/**/*"
  ],
  "extraResources": [
    {
      "from": "python-dist/",
      "to": "python-dist",
      "filter": ["**/*"]
    },
    {
      "from": "external-deps/tesseract/",
      "to": "tesseract",
      "filter": ["**/*"]
    }
  ],
  "asarUnpack": [
    "**/*.{node,dll,dylib,so}"
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/icon.ico",
    "publisherName": "Interview AI",
    "requestedExecutionLevel": "asInvoker",
    "artifactName": "Interview-AI-Portable-${version}.exe"
  },
  "portable": {
    "splashImage": null
  },
  "compression": "maximum",
  "removePackageScripts": true
}
