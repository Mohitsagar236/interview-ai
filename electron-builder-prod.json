{
  "appId": "com.interviewai.app",
  "productName": "Interview AI",
  "directories": {
    "output": "dist",
    "buildResources": "assets"
  },
  "files": [
    "electron/**/*",
    "renderer/**/*",
    "assets/**/*",
    "public/**/*",
    "package.json",
    ".env.example",
    "!python/**/*",
    "!python-dist/**/*"
  ],
  "extraResources": [
    {
      "from": "python-dist/",
      "to": "python-dist",
      "filter": ["**/*"]
    },
    {
      "from": "external-deps/tesseract/",
      "to": "tesseract",
      "filter": ["**/*"]
    }
  ],
  "extraMetadata": {
    "main": "electron/main.js"
  },
  "copyright": "Copyright (c) 2025-2026 interviewai. All rights reserved.",
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/icon.ico",
    "publisherName": "interviewai",
    "requestedExecutionLevel": "asInvoker",
    "artifactName": "Interview-AI-Setup-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Interview AI",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false,
    "installerIcon": "assets/icon.ico",
    "uninstallerIcon": "assets/icon.ico",
    "include": "build/installer.nsh"
  }
}
