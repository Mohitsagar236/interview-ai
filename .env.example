# Interview AI - BYOK Developer Configuration
#
# End users do not need this file. The packaged desktop app stores API keys
# through Settings. Developers can copy this file to .env for local testing.

# App mode
USE_LOCAL_SERVER=true
NODE_ENV=development
BYOK_MODE=true

# AI provider keys - choose at least one, or use Ollama locally.
OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=

# Transcription
DEEPGRAM_API_KEY=

# Model defaults
DEFAULT_LLM=openai/gpt-4o-mini
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=0
AI_MAX_NEW_TOKENS=0

# Public release/admin analytics
APP_VERSION=0.1.0
APP_BUILD_ID=20260625-144629
R2_PUBLIC_URL=https://pub-25ab7498cafd4a708df4eafca6fa14a3.r2.dev
ADMIN_TOKEN=change-this-before-deploy

# Persistent analytics storage for Vercel/Node deployments.
# Use either Vercel KV or Upstash Redis REST credentials.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Pages deployments:
# Bind a KV namespace named ANALYTICS_KV and set ADMIN_TOKEN in Pages settings.

# Desktop anonymous usage telemetry
INTERVIEW_AI_TELEMETRY_URL=https://interviewai.space/api/telemetry
INTERVIEW_AI_DISABLE_TELEMETRY=0

# Fast screen answering: skips OCR and sends the screenshot directly to a vision model.
FAST_SCREEN_VISION_FIRST=1
FAST_SCREEN_MODEL=openai/gpt-4o-mini
FAST_SCREEN_MAX_SIDE=1800
FAST_SCREEN_JPEG_QUALITY=82

# Streaming transcription
USE_STREAMING_TRANSCRIPTION=true
STREAMING_PROVIDER=deepgram
STREAMING_SAMPLE_RATE=16000
STREAMING_ENCODING=linear16
STREAMING_CHANNELS=1
STREAMING_INTERIM_RESULTS=true
STREAMING_PUNCTUATE=true
STREAMING_SMART_FORMAT=true
STREAMING_LANGUAGE=en-US
STREAMING_MODEL=nova-2
STREAMING_VAD_EVENTS=true
STREAMING_ENDPOINTING=300

# OCR
USE_PADDLEOCR=1
OCR_ENGINE=paddleocr
OCR_FALLBACK=1
OCR_FAST_MODE=0
OCR_VARIANT_BUDGET_SECONDS=4.0

# Behavior
AUTO_COACH_ENABLED=true
STREAM_CHUNK_MODE=fast
