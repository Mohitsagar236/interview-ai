# Interview AI - BYOK Developer Configuration
#
# End users do not need this file. The packaged desktop app stores API keys
# through Settings. Developers can copy this file to .env for local testing.

# App mode
USE_LOCAL_SERVER=true
NODE_ENV=development
BYOK_MODE=true

# Website download login (Supabase Auth)
# Use the public project URL and anon key only. Never put a service-role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# AI provider keys - choose at least one, or use Ollama locally.
OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=

# Transcription
DEEPGRAM_API_KEY=

# Model defaults
DEFAULT_LLM=openai/gpt-4o-mini
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=0
AI_MAX_NEW_TOKENS=0

# Fast screen answering: skips OCR and sends the screenshot directly to a vision model.
FAST_SCREEN_VISION_FIRST=1
FAST_SCREEN_MODEL=openai/gpt-4o-mini
FAST_SCREEN_MAX_SIDE=1800
FAST_SCREEN_JPEG_QUALITY=82

# Streaming transcription
USE_STREAMING_TRANSCRIPTION=true
STREAMING_PROVIDER=deepgram
STREAMING_SAMPLE_RATE=16000
STREAMING_ENCODING=linear16
STREAMING_CHANNELS=1
STREAMING_INTERIM_RESULTS=true
STREAMING_PUNCTUATE=true
STREAMING_SMART_FORMAT=true
STREAMING_LANGUAGE=en-US
STREAMING_MODEL=nova-2
STREAMING_VAD_EVENTS=true
STREAMING_ENDPOINTING=300

# OCR
USE_PADDLEOCR=1
OCR_ENGINE=paddleocr
OCR_FALLBACK=1
OCR_FAST_MODE=0
OCR_VARIANT_BUDGET_SECONDS=4.0

# Behavior
AUTO_COACH_ENABLED=true
STREAM_CHUNK_MODE=fast
