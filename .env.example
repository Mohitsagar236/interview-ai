# OpenRouter Configuration
# Obtain an API key from https://openrouter.ai/ and paste it here in your local .env (DO NOT COMMIT .env)
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Default model - use OpenRouter model IDs from https://openrouter.ai/models
# Reliable options:
#   openai/gpt-4o-mini    (fast, reliable, cost-effective - RECOMMENDED)
#   openai/gpt-4o         (most capable OpenAI model)
#   anthropic/claude-3.5-sonnet  (excellent reasoning)
#   x-ai/grok-beta        (experimental - may have limited availability)
DEFAULT_LLM=openai/gpt-4o-mini
AI_TEMPERATURE=0.2

# === REAL-TIME STREAMING TRANSCRIPTION (NEW) ===
# Enable for <200ms latency instead of 400-2000ms with Whisper
USE_STREAMING_TRANSCRIPTION=true
STREAMING_PROVIDER=deepgram

# Deepgram API Key (create at https://deepgram.com/)
# Required only if STREAMING_PROVIDER=deepgram
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_API_KEY

# Streaming Configuration (Optimized for real-time)
STREAMING_SAMPLE_RATE=16000
STREAMING_ENCODING=linear16
STREAMING_CHANNELS=1
STREAMING_INTERIM_RESULTS=true
STREAMING_PUNCTUATE=true
STREAMING_SMART_FORMAT=true
STREAMING_LANGUAGE=en-US
STREAMING_MODEL=nova-2
STREAMING_VAD_EVENTS=true
STREAMING_ENDPOINTING=300

# Token Limits for Interview Responses
# 500 tokens ≈ 375 words (concise interview answers)
# Increase for longer responses: 1000 = ~750 words, 2000 = ~1500 words, 0 = unlimited
AI_MAX_TOKENS=0
AI_MAX_NEW_TOKENS=0

# With shorter responses, continuation passes not needed
AI_CONTINUE_PASSES=1

# OpenRouter attribution headers
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_SITE_NAME=Interview AI Assistant



# === USER CONTROL (IMPORTANT) ===
# Auto-coach is DISABLED - user must click "Ask AI" button manually
# Set to false to ensure AI only responds when button is clicked
AUTO_COACH_ENABLED=false

# Streaming mode - use 'fast' to prevent hanging
STREAM_CHUNK_MODE=fast

# ULTRA-AGGRESSIVE streaming timeouts to prevent "thinking" hang
STREAM_FORCE_YIELD_SECONDS=0.01
STREAM_BUFFER_THRESHOLD=1
