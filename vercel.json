{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/activation.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/create-razorpay-order.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/download.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/grant-free-credits.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/payment-webhook.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/razorpay-webhook.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/verify-payment-auto.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/verify-payment.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/verify-razorpay-payment.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/activation",
      "dest": "/api/activation.js"
    },
    {
      "src": "/api/generate-activation-code",
      "dest": "/api/activation.js"
    },
    {
      "src": "/api/activate-desktop",
      "dest": "/api/activation.js"
    },
    {
      "src": "/api/get-credits-by-code",
      "dest": "/api/activation.js"
    },
    {
      "src": "/api/update-credits-by-code",
      "dest": "/api/activation.js"
    },
    {
      "src": "/api/deactivate-code",
      "dest": "/api/activation.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
