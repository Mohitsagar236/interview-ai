# ========================================
# Interview AI — Open Source Configuration
# ========================================
# Copy this file to .env and fill in your API keys.
# This app runs 100% locally on your machine.
#
# QUICK START:
#   1. Copy this file: cp .env.example .env
#   2. Add at least ONE AI API key below
#   3. Add a Deepgram key for voice transcription (optional)
#   4. Run: npm run dev

# === APP MODE ===
USE_LOCAL_SERVER=true
NODE_ENV=development
BYOK_MODE=true
SKIP_ACTIVATION=true

# ========================================
# AI API KEYS — Choose at least ONE
# ========================================

# Option 1: OpenRouter (RECOMMENDED — one key for ALL models)
#   Sign up at: https://openrouter.ai/keys
#   Supports: GPT-4o, Claude, Gemini, Llama, Mistral, and 200+ more
OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Option 2: Direct OpenAI
#   Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Option 3: Groq (FREE tier — ultra-fast open-source models)
#   Get key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option 4: xAI / Grok
#   Get key at: https://console.x.ai/
XAI_API_KEY=

# ========================================
# TRANSCRIPTION — For recording interviewer voice
# ========================================

# Deepgram (RECOMMENDED — $200 free credit on signup)
#   Sign up at: https://deepgram.com
DEEPGRAM_API_KEY=

# AssemblyAI (alternative)
#   Sign up at: https://www.assemblyai.com
ASSEMBLYAI_API_KEY=

# ========================================
# AI MODEL SETTINGS
# ========================================
# Use OpenRouter model format: provider/model-name
# Examples:
#   openai/gpt-4o-mini          — fast + cheap (RECOMMENDED)
#   openai/gpt-4o               — most capable
#   anthropic/claude-3.5-sonnet  — great for reasoning
#   google/gemini-flash-1.5      — very fast
#   meta-llama/llama-3.1-70b     — open source
#
# For direct OpenAI: gpt-4o-mini, gpt-4o
# For Groq: llama-3.3-70b-versatile, mixtral-8x7b-32768
DEFAULT_LLM=openai/gpt-4o-mini
AI_TEMPERATURE=0.2

# Token limits (0 = unlimited)
AI_MAX_TOKENS=0
AI_MAX_NEW_TOKENS=0

# ========================================
# STREAMING TRANSCRIPTION CONFIG
# ========================================
USE_STREAMING_TRANSCRIPTION=true
STREAMING_PROVIDER=deepgram
STREAMING_SAMPLE_RATE=16000
STREAMING_ENCODING=linear16
STREAMING_CHANNELS=1
STREAMING_INTERIM_RESULTS=true
STREAMING_PUNCTUATE=true
STREAMING_SMART_FORMAT=true
STREAMING_LANGUAGE=en-US
STREAMING_MODEL=nova-2
STREAMING_VAD_EVENTS=true
STREAMING_ENDPOINTING=300

# ========================================
# OCR CONFIGURATION
# ========================================
# PaddleOCR is most accurate (auto-installed with pip)
# Fallback: PaddleOCR -> EasyOCR -> Tesseract
USE_PADDLEOCR=1
OCR_ENGINE=paddleocr
OCR_FALLBACK=1
OCR_FAST_MODE=0
OCR_VARIANT_BUDGET_SECONDS=4.0

# ========================================
# BEHAVIOR
# ========================================
AUTO_COACH_ENABLED=true
STREAM_CHUNK_MODE=fast

