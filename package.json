{
  "name": "interview-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first Interview AI Assistant with real-time local Whisper, multi-LLM streaming, OCR, and stealth overlay",
  "author": {
    "name": "Interview AI",
    "email": "support@interview-ai.app",
    "url": "https://github.com/Mohitsagar236/interview-ai"
  },
  "homepage": "https://github.com/Mohitsagar236/interview-ai",
  "license": "MIT",
  "copyright": "Copyright © 2025 Interview AI",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node ./scripts/postinstall.js",
    "setup:py": "py -3 -m venv .venv && .\\.venv\\Scripts\\python.exe -m pip install -r python/requirements.txt",
    "dev": "concurrently -k -n py,app \".\\.venv\\Scripts\\python.exe python/server.py\" \"electron .\"",
    "prod": "concurrently -k -n py,app \".\\.venv\\Scripts\\python.exe python/launch_server.py\" \"electron .\"",
    "serve": "node dev-server.js",
    "test": "node ./scripts/smoke-test.js",
    "test:comprehensive": "cd python && python run_tests.py",
    "check:env": "cd python && python check_environment.py",
    "cleanup:duplicates": "node ./scripts/cleanup-duplicates.js",
    "start": "node scripts/start-electron.js",
    "verify-build": "node ./scripts/verify-build.js",
    "verify-prod": "node ./scripts/verify-production-build.js",
    "generate-icons": "node ./scripts/generate-icons.js",
    "prebuild": "node ./scripts/prepare-build.js",
    "build": "electron-builder",
    "build:prod": "cross-env NODE_ENV=production electron-builder --config electron-builder-prod.json",
    "build:dev": "electron-builder",
    "build:standalone": "node ./scripts/build-python-standalone.js && electron-builder",
    "build:win": "electron-builder --win",
    "build:portable": "node ./scripts/build-python-standalone.js && electron-builder --win --config electron-builder-portable.json",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:compact-bar": "cd compact-bar-app && npm install && npm run build",
    "pack": "electron-builder --dir",
    "lint": "echo 'No linter configured'",
    "vercel:deploy": "vercel --prod",
    "upload:r2": "node scripts/upload-to-r2.js",
    "upload:github": "node scripts/upload-to-github.js",
    "verify:coupons": "node ./scripts/verify-coupons.js",
    "release": "npm run build && npm run upload:r2"
  },
  "vercel": {
    "builds": [
      {
        "src": "api/*.py",
        "use": "@vercel/python"
      }
    ]
  },
  "build": {
    "appId": "space.interviewai.app",
    "productName": "Interview AI Assistant",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "public/**/*",
      "assets/**/*",
      "package.json",
      "!python/__pycache__/**/*",
      "!**/*.pyc",
      "!python-dist/**/*"
    ],
    "extraResources": [
      {
        "from": "python-dist/",
        "to": "python-dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "external-deps/tesseract/",
        "to": "tesseract",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/*.{node,dll,dylib,so}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        "portable"
      ],
      "icon": "assets/icon.ico",
      "publisherName": "Interview AI",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "Interview-AI-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Interview AI",
      "runAfterFinish": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    }
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron-store": "^8.1.0",
    "eventsource-parser": "^1.1.2",
    "node-fetch": "^3.3.2",
    "tesseract.js": "^5.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "electron-icon-builder": "^2.0.1",
    "express": "^5.1.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.4",
    "to-ico": "^1.1.5",
    "wait-on": "^8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mohitsagar236/interview-ai.git"
  },
  "bugs": {
    "url": "https://github.com/Mohitsagar236/interview-ai/issues"
  }
}
