{
  "name": "interview-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first Interview AI Assistant with real-time local Whisper, multi-LLM streaming, OCR, and stealth overlay",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node ./scripts/postinstall.js",
    "setup:py": "py -3 -m venv .venv && .\\.venv\\Scripts\\python.exe -m pip install -r python/requirements.txt",
    "dev": "concurrently -k -n py,app \".\\.venv\\Scripts\\python.exe python/server.py\" \"electron .\"",
    "prod": "concurrently -k -n py,app \".\\.venv\\Scripts\\python.exe python/launch_server.py\" \"electron .\"",
    "test": "node ./scripts/smoke-test.js",
    "test:comprehensive": "cd python && python run_tests.py",
    "check:env": "cd python && python check_environment.py",
    "cleanup:duplicates": "node ./scripts/cleanup-duplicates.js",
    "start": "electron .",
    "verify-build": "node ./scripts/verify-build.js",
    "prebuild": "node ./scripts/prepare-build.js",
    "build": "electron-builder",
    "build:standalone": "node ./scripts/build-python-standalone.js && electron-builder",
    "build:mac": "node ./scripts/build-python-standalone.js && electron-builder --mac",
    "build:compact-bar": "cd compact-bar-app && npm install && npm run build",
    "pack": "electron-builder --dir",
    "lint": "echo 'No linter configured'",
    "vercel:deploy": "vercel --prod"
  },
  "vercel": {
    "builds": [{ "src": "api/*.py", "use": "@vercel/python" }]
  },
  "build": {
    "appId": "com.example.interviewaiassistant",
    "productName": "Interview AI Assistant",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "python/**/*",
      "assets/**/*",
      "package.json",
      ".env",
      "!python/__pycache__/**/*",
      "!**/*.pyc"
    ],
    "extraResources": [
      {
        "from": "python-dist/",
        "to": "python-dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/*.{node,dll,dylib,so}",
      "**/python/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "publisherName": "Your Company",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    }
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "eventsource-parser": "^1.1.2",
    "node-fetch": "^3.3.2",
    "tesseract.js": "^5.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "wait-on": "^8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mohitsagar236/interview-ai.git"
  },
  "homepage": "https://github.com/Mohitsagar236/interview-ai#readme",
  "bugs": {
    "url": "https://github.com/Mohitsagar236/interview-ai/issues"
  }
}