{
  "name": "interview-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first free BYOK Interview AI Assistant with real-time transcription, OCR, and desktop coaching",
  "author": {
    "name": "Mohit Sagar",
    "email": "support@interview-ai.app",
    "url": "https://github.com/Mohitsagar236/interview-ai"
  },
  "homepage": "https://github.com/Mohitsagar236/interview-ai",
  "license": "UNLICENSED",
  "copyright": "Copyright (c) 2025-2026 Mohit Sagar. All rights reserved.",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node ./scripts/postinstall.js",
    "setup:py": "node ./scripts/prepare-build.js",
    "dev": "node scripts/start-electron.js",
    "prod": "node scripts/start-electron.js",
    "serve": "node dev-server.js",
    "test": "node ./scripts/smoke-test.js",
    "test:comprehensive": "node ./scripts/run-python-tests.js",
    "cleanup:duplicates": "node ./scripts/cleanup-duplicates.js",
    "start": "node scripts/start-electron.js",
    "verify-build": "node ./scripts/verify-build.js",
    "verify-prod": "node ./scripts/verify-production-build.js",
    "generate-icons": "node ./scripts/generate-icons.js",
    "prebuild": "node ./scripts/prepare-build.js",
    "build": "node ./scripts/build-python-standalone.js && electron-builder",
    "build:prod": "node ./scripts/build-python-standalone.js && cross-env NODE_ENV=production electron-builder --config electron-builder-prod.json",
    "build:dev": "electron-builder",
    "build:standalone": "node ./scripts/build-python-standalone.js && electron-builder",
    "build:win": "node ./scripts/build-python-standalone.js && electron-builder --win",
    "build:compact-bar": "cd compact-bar-app && npm install && npm run build",
    "pack": "electron-builder --dir",
    "lint": "echo 'No linter configured'",
    "vercel:deploy": "vercel --prod",
    "verify:coupons": "node ./scripts/verify-coupons.js",
    "release": "npm run build:prod"
  },
  "vercel": {
    "builds": [
      {
        "src": "api/*.py",
        "use": "@vercel/python"
      }
    ]
  },
  "build": {
    "appId": "space.interviewai.app",
    "productName": "Interview AI Assistant",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "public/**/*",
      "assets/**/*",
      "package.json",
      "!python/__pycache__/**/*",
      "!**/*.pyc",
      "!python-dist/**/*"
    ],
    "extraResources": [
      {
        "from": "python-dist/",
        "to": "python-dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "external-deps/tesseract/",
        "to": "tesseract",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/*.{node,dll,dylib,so}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "publisherName": "Mohit Sagar",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "Interview-AI-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Interview AI",
      "runAfterFinish": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron-store": "^8.1.0",
    "eventsource-parser": "^1.1.2",
    "node-fetch": "^3.3.2",
    "tesseract.js": "^5.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "express": "^5.1.0",
    "sharp": "^0.34.4",
    "to-ico": "^1.1.5",
    "wait-on": "^8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mohitsagar236/interview-ai.git"
  },
  "bugs": {
    "url": "https://github.com/Mohitsagar236/interview-ai/issues"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
